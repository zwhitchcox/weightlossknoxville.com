---
import BaseLayout from '../layouts/BaseLayout.astro';
import CTA from '../components/CTA.astro';
import { SITE_TITLE } from '../consts';

const bookHref = '/book?service=weight-loss-consultation';
---

<BaseLayout
  title="About Knoxville Weight Loss Clinic | Medical Weight Loss in Knoxville, TN"
  description="About Knoxville Weight Loss Clinic: medical weight loss in Knoxville, TN, with a once-a-week semaglutide or tirzepatide shot that makes you less hungry. Free consultation."
>
  <!-- Page Header -->
  <section class="bg-gradient-to-br from-primary-dark via-primary to-primary-light px-4 py-16 sm:px-6 sm:py-20 lg:px-8">
    <div class="mx-auto max-w-4xl text-center">
      <h1 class="font-serif text-4xl font-bold text-white sm:text-5xl">About {SITE_TITLE}</h1>
      <p class="mx-auto mt-4 max-w-2xl text-lg text-neutral-200">
        We help people in Knoxville lose weight with a once-a-week shot that makes them less hungry.
      </p>
    </div>
  </section>

  <!-- Our Mission -->
  <section class="bg-white px-4 py-16 sm:px-6 sm:py-20 lg:px-8">
    <div class="mx-auto max-w-4xl">
      <div class="grid gap-12 md:grid-cols-2 md:items-center">
        <div>
          <h2 class="font-serif text-3xl font-bold text-primary">Our Mission</h2>
          <p class="mt-4 leading-relaxed text-neutral-600">
            Diets are hard because you stay hungry. At Knoxville Weight Loss Clinic, we offer medical
            weight loss that works on the hunger itself: a once-a-week shot that makes you less hungry.
            You feel full sooner, you stay full longer, and the cravings quiet down.
          </p>
          <p class="mt-4 leading-relaxed text-neutral-600">
            We offer two GLP-1 medicines, semaglutide and tirzepatide. Semaglutide starts at $150 a month,
            tirzepatide starts at $250 a month, and the first consultation is free.
          </p>
        </div>
        <div class="rounded-xl border border-neutral-200 bg-neutral-50 p-8">
          <h3 class="font-serif text-xl font-semibold text-primary">What You Can Expect</h3>
          <ul class="mt-4 space-y-3">
            <li class="flex items-start gap-3">
              <svg class="mt-0.5 h-5 w-5 shrink-0 text-accent" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75L11.25 15 15 9.75" /></svg>
              <span class="text-sm text-neutral-700"><strong class="text-neutral-800">A Free First Consultation:</strong> Ask your questions and get your price before you decide.</span>
            </li>
            <li class="flex items-start gap-3">
              <svg class="mt-0.5 h-5 w-5 shrink-0 text-accent" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75L11.25 15 15 9.75" /></svg>
              <span class="text-sm text-neutral-700"><strong class="text-neutral-800">Clear Prices:</strong> Semaglutide from $150 a month. Tirzepatide from $250 a month.</span>
            </li>
            <li class="flex items-start gap-3">
              <svg class="mt-0.5 h-5 w-5 shrink-0 text-accent" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75L11.25 15 15 9.75" /></svg>
              <span class="text-sm text-neutral-700"><strong class="text-neutral-800">A Dose That Fits You:</strong> You start with a low dose, and we adjust the dose as you go.</span>
            </li>
            <li class="flex items-start gap-3">
              <svg class="mt-0.5 h-5 w-5 shrink-0 text-accent" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75L11.25 15 15 9.75" /></svg>
              <span class="text-sm text-neutral-700"><strong class="text-neutral-800">No Judgment:</strong> Many people come to us after diet after diet. We are glad you are here.</span>
            </li>
          </ul>
        </div>
      </div>
    </div>
  </section>

  <!-- Our Approach -->
  <section class="bg-neutral-50 px-4 py-16 sm:px-6 sm:py-20 lg:px-8">
    <div class="mx-auto max-w-4xl">
      <h2 class="text-center font-serif text-3xl font-bold text-primary">How Our Medical Weight Loss Works</h2>
      <p class="mx-auto mt-4 max-w-2xl text-center text-lg text-neutral-600">
        Medical weight loss is not about willpower. The shot works on the hunger that makes diets so hard.
      </p>

      <div class="mt-12 space-y-8">
        <div class="rounded-xl border border-neutral-200 bg-white p-6 md:p-8">
          <h3 class="font-serif text-xl font-semibold text-primary">Free Consultation</h3>
          <p class="mt-3 leading-relaxed text-neutral-600">
            Book online or call us. We talk about your goals and your health history, and we answer your
            questions. The first consultation is free.
          </p>
        </div>
        <div class="rounded-xl border border-neutral-200 bg-white p-6 md:p-8">
          <h3 class="font-serif text-xl font-semibold text-primary">Medical Evaluation</h3>
          <p class="mt-3 leading-relaxed text-neutral-600">
            A provider checks your health to see if the shot is right for you. Medication is prescribed
            only after this evaluation. Then you get your plan and your price.
          </p>
        </div>
        <div class="rounded-xl border border-neutral-200 bg-white p-6 md:p-8">
          <h3 class="font-serif text-xl font-semibold text-primary">Your Weekly Shot</h3>
          <p class="mt-3 leading-relaxed text-neutral-600">
            You take one small shot a week: <a href="/semaglutide/" class="font-semibold text-primary hover:text-primary-light">semaglutide</a>
            or <a href="/tirzepatide/" class="font-semibold text-primary hover:text-primary-light">tirzepatide</a>.
            You start with a low dose, and we adjust the dose as you go.
          </p>
        </div>
        <div class="rounded-xl border border-neutral-200 bg-white p-6 md:p-8">
          <h3 class="font-serif text-xl font-semibold text-primary">Tips for Eating Well</h3>
          <p class="mt-3 leading-relaxed text-neutral-600">
            The shot makes it easier to eat less. Read our
            <a href="/blog/nutrition-tips-weight-loss-medication/" class="font-semibold text-primary hover:text-primary-light">nutrition tips for weight loss medicine</a>
            to learn what to eat while you take it.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- Why Medical Weight Loss -->
  <section class="bg-white px-4 py-16 sm:px-6 sm:py-20 lg:px-8">
    <div class="mx-auto max-w-4xl">
      <h2 class="text-center font-serif text-3xl font-bold text-primary">Why Medical Weight Loss?</h2>
      <div class="mt-10 grid gap-6 sm:grid-cols-2">
        <div class="rounded-xl bg-neutral-50 p-6">
          <h3 class="font-serif text-lg font-semibold text-primary">The Science of Hunger</h3>
          <p class="mt-2 text-sm leading-relaxed text-neutral-600">
            After a meal, your gut makes hormones such as GLP-1 and GIP. They tell your brain that you have
            had enough to eat. Semaglutide and tirzepatide act like these hormones, so you feel full sooner
            and stay full longer.
          </p>
        </div>
        <div class="rounded-xl bg-neutral-50 p-6">
          <h3 class="font-serif text-lg font-semibold text-primary">Beyond Dieting</h3>
          <p class="mt-2 text-sm leading-relaxed text-neutral-600">
            Most diets fail because you stay hungry. That is not a lack of willpower. It is how the body
            works. Medical weight loss works on the hunger itself, so eating less is not a daily fight.
          </p>
        </div>
        <div class="rounded-xl bg-neutral-50 p-6">
          <h3 class="font-serif text-lg font-semibold text-primary">Less Hunger, Fewer Cravings</h3>
          <p class="mt-2 text-sm leading-relaxed text-neutral-600">
            You feel full on smaller meals, and the cravings quiet down. That makes it easier to build eating
            habits that last.
          </p>
        </div>
        <div class="rounded-xl bg-neutral-50 p-6">
          <h3 class="font-serif text-lg font-semibold text-primary">One Shot a Week</h3>
          <p class="mt-2 text-sm leading-relaxed text-neutral-600">
            There are no daily pills to remember. You take one small shot on the same day each week.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- Serving Knoxville -->
  <section class="bg-neutral-50 px-4 py-16 sm:px-6 sm:py-20 lg:px-8">
    <div class="mx-auto max-w-3xl text-center">
      <h2 class="font-serif text-3xl font-bold text-primary">Proudly Serving Knoxville and East Tennessee</h2>
      <p class="mt-4 leading-relaxed text-neutral-600">
        We see patients from Knoxville and all over East Tennessee, including Knox County, Farragut,
        Maryville, Oak Ridge and Sevierville. Maybe you have fought your weight for years. Maybe you are
        just starting to look at medical weight loss. Either way, we are here to help.
      </p>
      <p class="mt-4 leading-relaxed text-neutral-600">
        Asking for help with your weight takes courage. At Knoxville Weight Loss Clinic, there is no
        judgment. The focus is on your health and your goals.
      </p>
    </div>
  </section>

  <CTA
    heading="Book a Free Weight Loss Consultation"
    text="Find out if a once-a-week shot that makes you less hungry is right for you. Plans start at $150 a month."
    buttonText="Book Your Free Consultation"
    buttonHref={bookHref}
  />
</BaseLayout>
