---
import BaseLayout from '../layouts/BaseLayout.astro';
import CTA from '../components/CTA.astro';
import { SITE_URL, EMAIL, LOCATIONS } from '../consts';

const office = LOCATIONS.farragut;
const phoneHref = `tel:${office.phone.replace(/[^0-9+]/g, '')}`;
const bookHref = '/book?service=weight-loss-consultation&location=farragut';

// The Google listing of this office (Knoxville Weight Loss Clinic, Farragut).
const mapsUrl = 'https://maps.google.com/maps?cid=4084322432453461664';
const directionsUrl =
  'https://www.google.com/maps/dir/?api=1&destination=Knoxville+Weight+Loss+Clinic&destination_place_id=ChIJn1HGW2YvXIgRoEaM1pxtrjg';

// Same days and times as the Google listing. Boulevard books Farragut
// appointments on these two days only.
const hours = [
  { day: 'Tuesday', time: '9:00 AM - 7:00 PM' },
  { day: 'Wednesday', time: '9:00 AM - 7:00 PM' },
  { day: 'Other days', time: 'Closed' },
];

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'MedicalBusiness',
  '@id': `${SITE_URL}/farragut/#office`,
  name: 'Knoxville Weight Loss Clinic - Semaglutide & Tirzepatide',
  description:
    'Medical weight loss in Farragut, TN: a once-a-week semaglutide or tirzepatide shot that makes you less hungry. Plans from $150 a month.',
  url: `${SITE_URL}/farragut/`,
  telephone: office.phone,
  email: EMAIL,
  image: `${SITE_URL}/weight-loss.webp`,
  priceRange: '$$',
  address: {
    '@type': 'PostalAddress',
    streetAddress: `${office.street}, ${office.suite}`,
    addressLocality: office.city,
    addressRegion: office.state,
    postalCode: office.zip,
    addressCountry: 'US',
  },
  geo: {
    '@type': 'GeoCoordinates',
    latitude: 35.88044,
    longitude: -84.15906,
  },
  hasMap: mapsUrl,
  openingHoursSpecification: [
    {
      '@type': 'OpeningHoursSpecification',
      dayOfWeek: ['Tuesday', 'Wednesday'],
      opens: '09:00',
      closes: '19:00',
    },
  ],
};
---

<BaseLayout
  title="Weight Loss Clinic in Farragut, TN | Knoxville Weight Loss Clinic"
  description="Medical weight loss in Farragut, TN: a once-a-week shot that makes you less hungry, from $150 a month. Free consultation. 102 S Campbell Station Rd, Suite 8C."
>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  </Fragment>

  <!-- Hero -->
  <section class="relative overflow-hidden bg-primary-dark text-white px-4 py-16 sm:px-6 sm:py-20 lg:px-8">
    <div class="absolute inset-0 opacity-10">
      <svg class="h-full w-full" viewBox="0 0 100 100" preserveAspectRatio="none">
        <path d="M0 100 C 20 0 50 0 100 100 Z" fill="white" />
      </svg>
    </div>
    <div class="relative mx-auto max-w-4xl text-center">
      <div class="inline-flex items-center rounded-full bg-accent/20 px-4 py-1.5 text-sm font-semibold text-accent-light mb-6 border border-accent/20">
        Medical Weight Loss
      </div>
      <h1 class="font-serif text-4xl font-bold leading-tight sm:text-5xl">Weight Loss Clinic in Farragut, TN</h1>
      <p class="mx-auto mt-6 max-w-2xl text-lg leading-relaxed text-neutral-300">
        A once-a-week shot that makes you less hungry. You feel full sooner, you stay full longer,
        and the cravings quiet down. Plans start at <strong class="text-white">$150 a month</strong>,
        and the first consultation is free.
      </p>
      <div class="mt-10 flex flex-col gap-4 sm:flex-row sm:justify-center">
        <a
          href={bookHref}
          class="inline-flex items-center justify-center rounded-xl bg-accent px-8 py-4 text-base font-bold text-primary-dark shadow-xl transition-all hover:bg-accent-light hover:-translate-y-1"
        >
          Book a Free Consultation
        </a>
        <a
          href={phoneHref}
          class="inline-flex items-center justify-center rounded-xl bg-white/10 px-8 py-4 text-base font-bold text-white transition-all hover:bg-white/20 hover:-translate-y-1 border border-white/20"
        >
          Call {office.phone}
        </a>
      </div>
    </div>
  </section>

  <!-- Address, Phone and Hours -->
  <section class="bg-neutral-50 px-4 py-16 sm:px-6 sm:py-20 lg:px-8">
    <div class="mx-auto grid max-w-5xl gap-8 md:grid-cols-2">
      <div class="rounded-2xl bg-white p-8 shadow-card border border-neutral-100">
        <h2 class="font-serif text-2xl font-bold text-primary">Our Farragut Weight Loss Clinic</h2>
        <address class="mt-4 not-italic leading-relaxed text-neutral-700">
          Knoxville Weight Loss Clinic<br />
          {office.street}, {office.suite}<br />
          <span class="text-sm text-neutral-500">{office.inside}</span><br />
          {office.city}, {office.state} {office.zip}
        </address>
        <a href={phoneHref} class="mt-4 block text-lg font-semibold text-primary hover:text-primary-light">
          {office.phone}
        </a>
        <div class="mt-6 flex flex-col gap-3 sm:flex-row">
          <a
            href={directionsUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center justify-center rounded-lg bg-primary px-6 py-3 text-sm font-bold text-white transition-colors hover:bg-primary-light"
          >
            Get Directions
          </a>
          <a
            href={mapsUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center justify-center rounded-lg border-2 border-primary px-6 py-3 text-sm font-bold text-primary transition-colors hover:bg-primary hover:text-white"
          >
            Open in Google Maps
          </a>
        </div>
      </div>

      <div class="rounded-2xl bg-white p-8 shadow-card border border-neutral-100">
        <h2 class="font-serif text-2xl font-bold text-primary">Farragut Office Hours</h2>
        <div class="mt-4 space-y-2 text-neutral-600">
          {hours.map((row) => (
            <div class="flex justify-between border-b border-neutral-100 pb-2">
              <span>{row.day}</span>
              <span class="font-medium text-neutral-800">{row.time}</span>
            </div>
          ))}
        </div>
        <p class="mt-6 text-sm leading-relaxed text-neutral-600">
          Book online to see the open times at this office. Need a different day? We also see
          patients at our Bearden office, {LOCATIONS.bearden.street}, {LOCATIONS.bearden.suite}.
          <a href="/contact/" class="font-semibold text-primary hover:text-primary-light">See both offices</a>.
        </p>
      </div>
    </div>
  </section>

  <!-- Directions -->
  <section class="bg-white px-4 py-16 sm:px-6 sm:py-20 lg:px-8">
    <div class="mx-auto max-w-3xl">
      <h2 class="font-serif text-3xl font-bold text-primary text-center">Directions to Our Farragut Weight Loss Clinic</h2>
      <ol class="mt-10 space-y-6">
        <li class="flex gap-4">
          <span class="flex h-9 w-9 flex-shrink-0 items-center justify-center rounded-full bg-primary/10 text-sm font-bold text-primary">1</span>
          <p class="pt-1 leading-relaxed text-neutral-700">
            From I-40 or I-75, take exit 373, Campbell Station Road. Go south about 1.5 miles to Kingston Pike.
          </p>
        </li>
        <li class="flex gap-4">
          <span class="flex h-9 w-9 flex-shrink-0 items-center justify-center rounded-full bg-primary/10 text-sm font-bold text-primary">2</span>
          <p class="pt-1 leading-relaxed text-neutral-700">
            Saah Salon Suites is at the southeast corner of Kingston Pike and Campbell Station Road.
            It is the brick building behind First Citizens Bank.
          </p>
        </li>
        <li class="flex gap-4">
          <span class="flex h-9 w-9 flex-shrink-0 items-center justify-center rounded-full bg-primary/10 text-sm font-bold text-primary">3</span>
          <p class="pt-1 leading-relaxed text-neutral-700">
            Park in the lot at the building. Our office is Suite 8C, inside Saah Salon Suites.
          </p>
        </li>
      </ol>
    </div>
  </section>

  <!-- Medical Weight Loss in Farragut -->
  <section class="bg-neutral-50 px-4 py-16 sm:px-6 sm:py-20 lg:px-8">
    <div class="mx-auto max-w-5xl">
      <div class="text-center max-w-3xl mx-auto">
        <h2 class="font-serif text-3xl font-bold text-primary sm:text-4xl">Medical Weight Loss in Farragut</h2>
        <p class="mt-4 text-lg leading-relaxed text-neutral-600">
          The shot is a GLP-1 medicine: semaglutide or tirzepatide. You take it once a week. It makes
          you less hungry, so it is easier to eat less.
        </p>
      </div>
      <div class="mt-12 grid gap-8 md:grid-cols-3">
        <div class="rounded-2xl bg-white p-8 shadow-sm border border-neutral-100">
          <h3 class="font-serif text-xl font-bold text-neutral-900">1. Free consultation</h3>
          <p class="mt-3 leading-relaxed text-neutral-600">
            Book online or call <span class="whitespace-nowrap">{office.phone}</span>. We talk about your
            goals and your health history.
          </p>
        </div>
        <div class="rounded-2xl bg-white p-8 shadow-sm border border-neutral-100">
          <h3 class="font-serif text-xl font-bold text-neutral-900">2. Medical evaluation</h3>
          <p class="mt-3 leading-relaxed text-neutral-600">
            A provider checks your health to see if the shot is right for you. Then you get your plan
            and your price.
          </p>
        </div>
        <div class="rounded-2xl bg-white p-8 shadow-sm border border-neutral-100">
          <h3 class="font-serif text-xl font-bold text-neutral-900">3. Your weekly shot</h3>
          <p class="mt-3 leading-relaxed text-neutral-600">
            You start with a low dose. We adjust the dose as you go.
          </p>
        </div>
      </div>
      <div class="mt-12 grid gap-6 md:grid-cols-2">
        <a href="/semaglutide/" class="group rounded-2xl bg-white p-6 border border-neutral-100 transition-all hover:shadow-md">
          <span class="text-sm font-bold text-accent-dark">From $150 a month</span>
          <span class="mt-1 block font-serif text-xl font-bold text-neutral-900 group-hover:text-primary">Semaglutide for weight loss</span>
        </a>
        <a href="/tirzepatide/" class="group rounded-2xl bg-white p-6 border border-neutral-100 transition-all hover:shadow-md">
          <span class="text-sm font-bold text-accent-dark">From $250 a month</span>
          <span class="mt-1 block font-serif text-xl font-bold text-neutral-900 group-hover:text-primary">Tirzepatide for weight loss</span>
        </a>
      </div>
      <p class="mt-8 text-center text-xs text-neutral-500">
        Medication is prescribed only after a medical evaluation. Results vary.
      </p>
    </div>
  </section>

  <CTA
    heading="Book a Free Weight Loss Consultation in Farragut"
    text="Pick a Tuesday or Wednesday time online. It takes about a minute."
    buttonText="Book Your Free Consultation"
    buttonHref={bookHref}
  />
</BaseLayout>
