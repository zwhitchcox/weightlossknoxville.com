---
import BaseLayout from '../layouts/BaseLayout.astro';
import CTA from '../components/CTA.astro';
import { SITE_URL, PHONE } from '../consts';

const bookHref = '/book?service=weight-loss-consultation';

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'MedicalWebPage',
  name: 'Semaglutide Weight Loss Treatment in Knoxville, TN',
  description: 'Semaglutide for medical weight loss at Knoxville Weight Loss Clinic in Knoxville, TN: a once-a-week shot that makes you less hungry, from $150 a month.',
  url: `${SITE_URL}/semaglutide/`,
  lastReviewed: new Date().toISOString().split('T')[0],
  medicalAudience: {
    '@type': 'MedicalAudience',
    audienceType: 'Patient',
  },
  mainContentOfPage: {
    '@type': 'WebPageElement',
    about: {
      '@type': 'Drug',
      name: 'Semaglutide',
      drugClass: 'GLP-1 Receptor Agonist',
      administrationRoute: 'Subcutaneous injection',
      mechanismOfAction: 'GLP-1 receptor agonist that reduces appetite and slows gastric emptying',
    },
  },
};
---

<BaseLayout
  title="Semaglutide Weight Loss Treatment | Knoxville TN | Knoxville Weight Loss Clinic"
  description="Semaglutide for medical weight loss in Knoxville, TN: a once-a-week shot that makes you less hungry. From $150 a month. Free consultation."
>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  </Fragment>

  <!-- Hero -->
  <section class="relative overflow-hidden bg-primary-dark text-white">
    <!-- Abstract Pattern -->
    <div class="absolute inset-0 opacity-10">
      <svg class="h-full w-full" viewBox="0 0 100 100" preserveAspectRatio="none">
        <path d="M0 100 C 20 0 50 0 100 100 Z" fill="white" />
      </svg>
    </div>

    <div class="relative mx-auto max-w-7xl px-4 py-16 sm:px-6 sm:py-24 lg:px-8">
      <div class="grid gap-12 lg:grid-cols-2 lg:items-center">
        <div>
          <div class="inline-flex items-center rounded-full bg-accent/20 px-3 py-1 text-xs font-semibold text-accent-light mb-6 border border-accent/20">
            Once-a-Week Shot
          </div>
          <h1 class="font-serif text-4xl font-bold leading-tight sm:text-5xl lg:text-6xl">
            Semaglutide for <br/><span class="text-accent">Medical Weight Loss</span>
          </h1>
          <p class="mt-6 text-lg leading-relaxed text-neutral-300 max-w-2xl">
            A once-a-week shot that makes you less hungry. You feel full sooner, you stay full longer,
            and the cravings quiet down. Semaglutide starts at <strong class="text-white">$150 a month</strong>,
            and the first consultation is free.
          </p>
          <div class="mt-8 flex flex-col gap-4 sm:flex-row">
            <a href={bookHref} class="inline-flex items-center justify-center rounded-xl bg-accent px-8 py-3.5 text-base font-bold text-primary-dark shadow-lg transition-transform hover:bg-accent-light hover:-translate-y-1">
              Book a Free Consultation
            </a>
            <a href="#how-it-works" class="inline-flex items-center justify-center rounded-xl border border-white/20 bg-white/5 px-8 py-3.5 text-base font-semibold text-white backdrop-blur-sm transition-colors hover:bg-white/10">
              How It Works
            </a>
          </div>
          <p class="mt-8 text-xs text-neutral-300">
            Medication is prescribed only after a medical evaluation. Results vary.
          </p>
        </div>

        <!-- Stats/Visual -->
        <div class="hidden lg:grid grid-cols-2 gap-4">
          <div class="rounded-2xl bg-white/5 p-6 backdrop-blur-sm border border-white/10">
            <p class="font-serif text-3xl font-bold text-accent">Less</p>
            <p class="text-sm text-neutral-400 mt-1">Hunger and Cravings</p>
          </div>
          <div class="rounded-2xl bg-white/5 p-6 backdrop-blur-sm border border-white/10">
            <p class="font-serif text-3xl font-bold text-accent">Weekly</p>
            <p class="text-sm text-neutral-400 mt-1">One Small Shot</p>
          </div>
          <div class="rounded-2xl bg-white/5 p-6 backdrop-blur-sm border border-white/10">
            <p class="font-serif text-3xl font-bold text-accent">$150</p>
            <p class="text-sm text-neutral-400 mt-1">Starting Monthly Price</p>
          </div>
          <div class="rounded-2xl bg-white/5 p-6 backdrop-blur-sm border border-white/10">
            <p class="font-serif text-3xl font-bold text-accent">Free</p>
            <p class="text-sm text-neutral-400 mt-1">First Consultation</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <div class="bg-neutral-50 py-12 sm:py-16 lg:py-20">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="grid gap-12 lg:grid-cols-3">

        <!-- Sidebar Navigation (Sticky) -->
        <div class="hidden lg:block lg:col-span-1">
          <div class="sticky top-24 space-y-8">
            <nav class="rounded-xl bg-white p-6 shadow-sm border border-neutral-100">
              <h3 class="font-serif text-lg font-bold text-primary mb-4">On This Page</h3>
              <ul class="space-y-3 text-sm">
                <li><a href="#what-is-semaglutide" class="block text-neutral-600 hover:text-primary transition-colors">What Is Semaglutide?</a></li>
                <li><a href="#how-it-works" class="block text-neutral-600 hover:text-primary transition-colors">How It Works</a></li>
                <li><a href="#benefits" class="block text-neutral-600 hover:text-primary transition-colors">Benefits</a></li>
                <li><a href="#candidacy" class="block text-neutral-600 hover:text-primary transition-colors">Who It Is For</a></li>
                <li><a href="#process" class="block text-neutral-600 hover:text-primary transition-colors">Getting Started</a></li>
                <li><a href="#side-effects" class="block text-neutral-600 hover:text-primary transition-colors">Side Effects</a></li>
                <li><a href="#faq" class="block text-neutral-600 hover:text-primary transition-colors">FAQ</a></li>
              </ul>
            </nav>

            <div class="rounded-xl bg-primary p-6 text-white shadow-lg">
              <h3 class="font-serif text-lg font-bold mb-1">Semaglutide</h3>
              <p class="text-2xl font-bold text-accent mb-2">From $150 a month</p>
              <p class="text-sm text-primary-light/90 mb-4">The first consultation is free. Book online in about a minute.</p>
              <a href={bookHref} class="block w-full rounded-lg bg-white py-3 text-center text-sm font-bold text-primary hover:bg-neutral-100 transition-colors">
                Book a Free Consultation
              </a>
              <a href={`tel:${PHONE.replace(/[^0-9+]/g, '')}`} class="block w-full mt-3 text-center text-sm font-medium text-white/80 hover:text-white transition-colors">
                Call {PHONE}
              </a>
            </div>
          </div>
        </div>

        <!-- Main Content -->
        <div class="lg:col-span-2">
          <div class="prose max-w-none">

            <!-- Key Takeaways Box -->
            <div class="not-prose rounded-xl bg-accent/10 border border-accent/20 p-6 mb-10">
              <h3 class="font-serif text-xl font-bold text-primary-dark mb-3 flex items-center gap-2">
                <svg class="w-5 h-5 text-accent-dark" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M12 18v-5.25m0 0a6.01 6.01 0 001.5-.189m-1.5.189a6.01 6.01 0 01-1.5-.189m3.75 7.478a12.06 12.06 0 01-4.5 0m3.75 2.383a14.406 14.406 0 01-3 0M14.25 18v-.192c0-.983.658-1.823 1.508-2.316a7.5 7.5 0 10-7.517 0c.85.493 1.509 1.333 1.509 2.316V18" /></svg>
                Key Takeaways
              </h3>
              <ul class="space-y-2 text-neutral-700 text-sm">
                <li class="flex items-start gap-2">
                  <span class="text-accent-dark font-bold">•</span>
                  <span><strong>Less Hunger:</strong> You feel full sooner, and you stay full longer.</span>
                </li>
                <li class="flex items-start gap-2">
                  <span class="text-accent-dark font-bold">•</span>
                  <span><strong>Fewer Cravings:</strong> The cravings quiet down, so it is easier to eat less.</span>
                </li>
                <li class="flex items-start gap-2">
                  <span class="text-accent-dark font-bold">•</span>
                  <span><strong>One Shot a Week:</strong> There are no daily pills to remember.</span>
                </li>
                <li class="flex items-start gap-2">
                  <span class="text-accent-dark font-bold">•</span>
                  <span><strong>From $150 a Month:</strong> The first consultation is free.</span>
                </li>
              </ul>
            </div>

            <h2 id="what-is-semaglutide">What Is Semaglutide?</h2>
            <p>
              Semaglutide is a GLP-1 medicine for weight loss. It acts like GLP-1, a hormone that your
              body makes after a meal. You take it as a small shot under the skin, once a week.
            </p>
            <p>
              At Knoxville Weight Loss Clinic, semaglutide is our lowest-priced weight loss plan. It
              starts at $150 a month, and your first consultation is free.
            </p>

            <h2 id="how-it-works">How Does Semaglutide Work?</h2>
            <p>
              After you eat, your gut makes GLP-1. This hormone tells your brain that you have had enough
              to eat. Semaglutide acts like GLP-1, and one shot lasts a full week:
            </p>
            <ul>
              <li><strong>Less hunger:</strong> It acts on the part of your brain that controls appetite.</li>
              <li><strong>Full sooner, full longer:</strong> Food leaves your stomach more slowly, so a
                smaller meal is enough.</li>
              <li><strong>Fewer cravings:</strong> The cravings quiet down, so it is easier to eat less.</li>
            </ul>

            <h2 id="benefits">Benefits of Semaglutide for Weight Loss</h2>
            <div class="grid sm:grid-cols-2 gap-4 not-prose my-8">
              <div class="flex items-start gap-3 p-4 rounded-lg bg-white border border-neutral-100 shadow-sm">
                <svg class="w-6 h-6 text-primary flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75L11.25 15 15 9.75M21 12a9 9 0 11-18 0 9 9 0 0118 0z" /></svg>
                <span class="text-sm text-neutral-700">Eating less is not a daily fight</span>
              </div>
              <div class="flex items-start gap-3 p-4 rounded-lg bg-white border border-neutral-100 shadow-sm">
                <svg class="w-6 h-6 text-primary flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75L11.25 15 15 9.75M21 12a9 9 0 11-18 0 9 9 0 0118 0z" /></svg>
                <span class="text-sm text-neutral-700">One shot a week, no daily pills</span>
              </div>
              <div class="flex items-start gap-3 p-4 rounded-lg bg-white border border-neutral-100 shadow-sm">
                <svg class="w-6 h-6 text-primary flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75L11.25 15 15 9.75M21 12a9 9 0 11-18 0 9 9 0 0118 0z" /></svg>
                <span class="text-sm text-neutral-700">A low starting dose, adjusted as you go</span>
              </div>
              <div class="flex items-start gap-3 p-4 rounded-lg bg-white border border-neutral-100 shadow-sm">
                <svg class="w-6 h-6 text-primary flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75L11.25 15 15 9.75M21 12a9 9 0 11-18 0 9 9 0 0118 0z" /></svg>
                <span class="text-sm text-neutral-700">A clear price, from $150 a month</span>
              </div>
            </div>

            <h2 id="candidacy">Who Is Semaglutide For?</h2>
            <p>
              Semaglutide is for adults who want to lose weight and are tired of fighting hunger. To find
              out if it is right for you, book a free consultation. Then a provider does a medical
              evaluation. The provider looks at your health history and the medicines you take, and
              decides if semaglutide is safe for you.
            </p>
            <p>
              Semaglutide is not safe for everyone. For example, it is not for people who are pregnant or
              who have had certain thyroid cancers.
            </p>

            <h2 id="process">How to Start Semaglutide in Knoxville</h2>
            <div class="not-prose space-y-8 my-8">
              <div class="flex gap-6">
                <div class="flex-shrink-0 w-12 h-12 rounded-full bg-primary text-white flex items-center justify-center font-bold text-lg">1</div>
                <div>
                  <h3 class="font-serif text-xl font-bold text-neutral-900 mb-2">Free Consultation</h3>
                  <p class="text-neutral-600 text-sm leading-relaxed">
                    Book online or call us. We talk about your goals and your health history, and we answer
                    your questions.
                  </p>
                </div>
              </div>
              <div class="flex gap-6">
                <div class="flex-shrink-0 w-12 h-12 rounded-full bg-primary text-white flex items-center justify-center font-bold text-lg">2</div>
                <div>
                  <h3 class="font-serif text-xl font-bold text-neutral-900 mb-2">Medical Evaluation</h3>
                  <p class="text-neutral-600 text-sm leading-relaxed">
                    A provider checks your health to see if semaglutide is right for you. Then you get your
                    plan and your price.
                  </p>
                </div>
              </div>
              <div class="flex gap-6">
                <div class="flex-shrink-0 w-12 h-12 rounded-full bg-primary text-white flex items-center justify-center font-bold text-lg">3</div>
                <div>
                  <h3 class="font-serif text-xl font-bold text-neutral-900 mb-2">Your Weekly Shot</h3>
                  <p class="text-neutral-600 text-sm leading-relaxed">
                    You take one shot a week. You start with a low dose, and we adjust the dose as you go.
                  </p>
                </div>
              </div>
            </div>

            <h2 id="side-effects">Side Effects of Semaglutide</h2>
            <p>
              The most common side effects are nausea, diarrhea and constipation. For most people they are
              mild, and they often get better as the body gets used to the medicine. This is one reason that
              you start with a low dose.
            </p>
            <p>
              To help, eat smaller meals, eat slowly and drink plenty of water. Our
              <a href="/blog/nutrition-tips-weight-loss-medication/">nutrition tips for weight loss medicine</a>
              have more ideas. If a side effect does not go away, tell us.
            </p>

            <h2 id="faq">Frequently Asked Questions</h2>
            <div class="not-prose space-y-4 my-8">
              <details class="group rounded-xl border border-neutral-200 bg-white shadow-sm">
                <summary class="flex cursor-pointer items-center justify-between px-6 py-4 font-medium text-neutral-900">
                  How much does semaglutide cost?
                  <span class="ml-6 flex h-7 w-7 items-center justify-center rounded-full bg-primary/10 text-primary transition group-open:-rotate-180">
                    <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M19.5 8.25l-7.5 7.5-7.5-7.5" /></svg>
                  </span>
                </summary>
                <div class="px-6 pb-4 text-sm text-neutral-600 leading-relaxed">
                  Semaglutide starts at $150 a month. The first consultation is free. You get your exact price after your medical evaluation.
                </div>
              </details>
              <details class="group rounded-xl border border-neutral-200 bg-white shadow-sm">
                <summary class="flex cursor-pointer items-center justify-between px-6 py-4 font-medium text-neutral-900">
                  How long do I need to take it?
                  <span class="ml-6 flex h-7 w-7 items-center justify-center rounded-full bg-primary/10 text-primary transition group-open:-rotate-180">
                    <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M19.5 8.25l-7.5 7.5-7.5-7.5" /></svg>
                  </span>
                </summary>
                <div class="px-6 pb-4 text-sm text-neutral-600 leading-relaxed">
                  It depends on your goals. Many people take it for months or longer. Talk with your provider before you stop, because the hunger can come back.
                </div>
              </details>
              <details class="group rounded-xl border border-neutral-200 bg-white shadow-sm">
                <summary class="flex cursor-pointer items-center justify-between px-6 py-4 font-medium text-neutral-900">
                  What if I feel sick to my stomach?
                  <span class="ml-6 flex h-7 w-7 items-center justify-center rounded-full bg-primary/10 text-primary transition group-open:-rotate-180">
                    <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M19.5 8.25l-7.5 7.5-7.5-7.5" /></svg>
                  </span>
                </summary>
                <div class="px-6 pb-4 text-sm text-neutral-600 leading-relaxed">
                  Nausea is common at the start, and it usually gets better. Eat smaller meals, eat slowly and drink water. We can also adjust your dose.
                </div>
              </details>
            </div>

          </div>
        </div>
      </div>
    </div>
  </div>

  <CTA
    heading="Start Semaglutide in Knoxville"
    text="Book a free consultation to find out if a once-a-week shot that makes you less hungry is right for you. Semaglutide starts at $150 a month."
    buttonText="Book Your Free Consultation"
    buttonHref={bookHref}
  />
</BaseLayout>
