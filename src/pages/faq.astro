---
import BaseLayout from '../layouts/BaseLayout.astro';
import CTA from '../components/CTA.astro';
import { SITE_URL, PHONE } from '../consts';

const bookHref = '/book?service=weight-loss-consultation';

const faqs = [
  {
    question: 'What is medical weight loss?',
    answer: 'Medical weight loss uses medicine to help you lose weight. At Knoxville Weight Loss Clinic, that medicine is a GLP-1 shot, semaglutide or tirzepatide, that you take once a week. It makes you less hungry. You feel full sooner, you stay full longer, and the cravings quiet down, so it is easier to eat less.',
  },
  {
    question: 'How much does it cost?',
    answer: 'Semaglutide starts at $150 a month. Tirzepatide starts at $250 a month. The first consultation is free, and you get your exact price after your medical evaluation.',
  },
  {
    question: 'Is the first consultation free?',
    answer: 'Yes. Your first consultation is free. Book online in about a minute, or call us.',
  },
  {
    question: 'What medicines do you offer for weight loss?',
    answer: 'We offer semaglutide and tirzepatide. Both are once-a-week shots that make you less hungry. Medication is prescribed only after a medical evaluation.',
  },
  {
    question: 'What is the difference between semaglutide and tirzepatide?',
    answer: 'Both are once-a-week shots that make you less hungry. Semaglutide acts like one hormone that your body makes after a meal, GLP-1. Tirzepatide acts like two, GLP-1 and GIP. Semaglutide starts at $150 a month, and tirzepatide starts at $250 a month. After your medical evaluation, you and your provider pick the one that fits your health, your goals and your budget.',
  },
  {
    question: 'How much weight will I lose?',
    answer: 'Results vary from person to person, so we do not promise a number. What the shot does is make you less hungry, so it is easier to eat less.',
  },
  {
    question: 'Who can get the shot?',
    answer: 'Adults who want to lose weight can book a free consultation. Then a provider does a medical evaluation. The provider looks at your health history and the medicines you take, and decides if the shot is safe and right for you. The shot is not safe for everyone. For example, it is not for people who are pregnant.',
  },
  {
    question: 'What happens at my first consultation?',
    answer: 'Your first consultation is free and takes about 30 minutes. We talk about your goals and your health history, and we answer your questions. If you want to start, a provider does a medical evaluation to see if the shot is right for you. Then you get your plan and your price.',
  },
  {
    question: 'How is the shot given?',
    answer: 'It is a small shot under the skin, once a week, with a very small needle. You can come in to our office for your shot, or ask us about giving it to yourself at home.',
  },
  {
    question: 'What are the common side effects?',
    answer: 'The most common side effects are nausea, diarrhea and constipation. For most people they are mild, and they often get better as the body gets used to the medicine. You start with a low dose, and we adjust the dose as you go. Smaller meals, eating slowly and plenty of water also help.',
  },
  {
    question: 'How often do I come in?',
    answer: 'It depends on your plan. Some patients come in each week for their shot. Others come in about once a month.',
  },
  {
    question: 'Does insurance cover weight loss medicine?',
    answer: 'Coverage for weight loss medicine depends on your insurance plan. Our plans have a simple monthly price: semaglutide from $150 a month and tirzepatide from $250 a month. The first consultation is free.',
  },
  {
    question: 'Will I gain the weight back if I stop?',
    answer: 'Some people gain weight back after they stop, because the hunger comes back. Use your time on the shot to build habits that last, such as eating more protein and moving more. Talk with your provider before you stop.',
  },
  {
    question: 'Can I take the shot if I have diabetes?',
    answer: 'In many cases, yes. GLP-1 medicines were first used for type 2 diabetes. At your medical evaluation, tell the provider about your diabetes and the medicines you take. The provider decides if the shot is safe for you.',
  },
  {
    question: 'Do you see patients from outside Knoxville?',
    answer: 'Yes. We see patients from all over East Tennessee, including Farragut, Maryville, Alcoa, Oak Ridge, Clinton and Sevierville.',
  },
];

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map((faq) => ({
    '@type': 'Question',
    name: faq.question,
    acceptedAnswer: {
      '@type': 'Answer',
      text: faq.answer,
    },
  })),
};
---

<BaseLayout
  title="Frequently Asked Questions | Knoxville Weight Loss Clinic | Knoxville TN"
  description="Answers to common questions about medical weight loss, tirzepatide, semaglutide, insurance coverage, and our program at Knoxville Weight Loss Clinic in Knoxville, TN."
>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  </Fragment>

  <!-- Hero -->
  <section class="bg-gradient-to-br from-primary-dark via-primary to-primary-light px-4 py-14 sm:px-6 sm:py-16 lg:px-8">
    <div class="mx-auto max-w-4xl text-center">
      <h1 class="font-serif text-4xl font-bold text-white sm:text-5xl">Frequently Asked Questions</h1>
      <p class="mx-auto mt-4 max-w-2xl text-lg text-neutral-200">
        Answers to common questions about medical weight loss, our once-a-week shots, prices and what to expect.
      </p>
    </div>
  </section>

  <!-- FAQ List -->
  <section class="bg-neutral-50 px-4 py-16 sm:px-6 sm:py-20 lg:px-8">
    <div class="mx-auto max-w-3xl">
      <div class="space-y-4">
        {faqs.map((faq, i) => (
          <details class="group rounded-xl border border-neutral-200 bg-white shadow-sm" open={i === 0}>
            <summary class="flex cursor-pointer items-center justify-between px-6 py-5 font-medium text-neutral-800 [&::-webkit-details-marker]:hidden">
              <span class="pr-4">{faq.question}</span>
              <svg class="h-5 w-5 shrink-0 text-neutral-400 transition-transform group-open:rotate-180" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
              </svg>
            </summary>
            <div class="border-t border-neutral-100 px-6 py-4 text-sm leading-relaxed text-neutral-600">
              {faq.answer}
            </div>
          </details>
        ))}
      </div>

      <div class="mt-12 text-center">
        <p class="text-neutral-600">
          Don't see your question? Contact us directly.
        </p>
        <div class="mt-4 flex flex-col items-center justify-center gap-4 sm:flex-row">
          <a href="/contact/" class="inline-block rounded-lg bg-primary px-6 py-3 text-sm font-semibold text-white transition-colors hover:bg-primary-light">
            Contact Us
          </a>
          <a href={`tel:${PHONE.replace(/[^0-9+]/g, '')}`} class="inline-block rounded-lg border-2 border-primary px-6 py-3 text-sm font-semibold text-primary transition-colors hover:bg-primary hover:text-white">
            Call {PHONE}
          </a>
        </div>
      </div>
    </div>
  </section>

  <CTA
    heading="Ready to Get Started?"
    text="Book a free consultation to find out if a once-a-week shot that makes you less hungry is right for you. Plans start at $150 a month."
    buttonText="Book Your Free Consultation"
    buttonHref={bookHref}
  />
</BaseLayout>
