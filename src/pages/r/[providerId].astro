---
// Review link landing page: QR codes point here (weightlossknoxvilletn.com/r/<provider>).
// Public but noindex; SSR so it never appears in the sitemap.
//
// Zane, 2026-09-30: every review goes to Botox Knox, whatever the client came in
// for. The Botox Knox page keeps the sample text honest through `svc` and keeps
// the QR-vs-NFC attribution through `via`. The old per-listing buttons for the
// Knoxville Weight Loss Clinic profiles are in git history if this changes back.
export const prerender = false;

const { providerId } = Astro.params;
const via = Astro.url.searchParams.get('via');
const target = new URL(`https://botoxknoxvilletn.com/r/${providerId}`);
if (via) target.searchParams.set('via', via);
target.searchParams.set('svc', 'weight-loss');
return Astro.redirect(target.toString(), 302);
---
